extends SceneTree

const GraphViewScript = preload("res://scripts/graph_series_view.gd")

func _initialize() -> void:
	var view = GraphViewScript.new()
	root.add_child(view)
	view.size = Vector2(600, 180)
	assert(view.series_by_quantity.is_empty(), "No graph data can appear before a real result is admitted")
	assert(view.active_quantity == "concentration", "The workspace should start with concentration mode")

	# Synthetic unit-test samples verify only presentation semantics, not
	# chemical accuracy, external provenance or a functioning solver bridge.
	var fixture := {
		"series_id": "synthetic-view-test",
		"result_ref": {"id": "synthetic-result", "record_revision": 1},
		"quantity_key": "concentration",
		"unit_id": "mol/m3",
		"samples": [
			{"time_s": 0.0, "value_status": "valid", "value": 0.0},
			{"time_s": 1.0, "value_status": "valid", "value": 4.0},
			{"time_s": 2.0, "value_status": "missing"},
			{"time_s": 3.0, "value_status": "valid", "value": 2.0},
			{"time_s": 4.0, "value_status": "valid", "value": 1.0}
		]
	}
	var admitted: Dictionary = view.submit_series(fixture, "0.1")
	assert(bool(admitted.get("ok", false)), "A well-typed synthetic series should be displayable")
	assert(int(admitted.get("valid_points")) == 4, "Measured zero is valid data, not a missing value")
	assert(int(admitted.get("gaps")) == 1, "Missing data should be counted as a visible gap")
	var accepted: Dictionary = view.series_by_quantity["concentration"]
	assert(accepted.segments.size() == 2, "Missing samples must break the visual polyline")
	assert(accepted.segments[0].size() == 2 and accepted.segments[1].size() == 2, "Segments must contain only adjacent valid samples")
	assert(float(accepted.segments[0][0].value) == 0.0, "Present measured zero must be preserved")

	var invalid_version: Dictionary = view.submit_series(fixture, "9.9")
	assert(not bool(invalid_version.get("ok", true)), "Unknown contract versions must fail closed")
	assert(not view.series_by_quantity.has("concentration"), "A rejected replacement must not leave stale series visible")
	assert(view.error_by_quantity.has("concentration"), "Failed admission should retain an explicit error")

	var missing_with_value := fixture.duplicate(true)
	missing_with_value.samples[2]["value"] = 0.0
	assert(not bool(view.submit_series(missing_with_value, "0.1").get("ok", true)), "Missing samples must not be recoded as zero")

	var nonmonotonic := fixture.duplicate(true)
	nonmonotonic.samples[3]["time_s"] = 1.0
	assert(not bool(view.submit_series(nonmonotonic, "0.1").get("ok", true)), "Repeated or descending timestamps must be rejected")

	var nonfinite := fixture.duplicate(true)
	nonfinite.samples[0]["value"] = INF
	assert(not bool(view.submit_series(nonfinite, "0.1").get("ok", true)), "Non-finite sample values cannot be graphed")

	var invalid_ref := fixture.duplicate(true)
	invalid_ref["result_ref"] = {"id": "synthetic-result", "record_revision": 0}
	assert(not bool(view.submit_series(invalid_ref, "0.1").get("ok", true)), "A result revision must be positive")

	var wrong_unit := fixture.duplicate(true)
	wrong_unit["unit_id"] = "K"
	assert(not bool(view.submit_series(wrong_unit, "0.1").get("ok", true)), "Units must be compatible with the active quantity")

	var out_of_domain := fixture.duplicate(true)
	out_of_domain.samples[2]["value_status"] = "out_of_domain"
	assert(bool(view.submit_series(out_of_domain, "0.1").get("ok", false)), "Out-of-domain gaps may be shown, but never interpolated")
	assert(view.series_by_quantity["concentration"].segments.size() == 2, "Out-of-domain samples must also break the curve")

	view.set_active_quantity("temperature")
	assert(view.active_quantity == "temperature", "The temperature tab should be independently selectable")
	assert(not view.series_by_quantity.has("temperature"), "Selecting a new tab must not fabricate a time series")
	var temp_fixture := {
		"series_id": "synthetic-temperature",
		"result_ref": {"id": "synthetic-result", "record_revision": 1},
		"quantity_key": "temperature",
		"unit_id": "K",
		"samples": [
			{"time_s": 0.0, "value_status": "valid", "value": 298.15},
			{"time_s": 1.0, "value_status": "valid", "value": 298.15}
		]
	}
	assert(bool(view.submit_series(temp_fixture, "0.1").get("ok", false)), "A caller-supplied isothermal unit-test series should render")
	assert(view.series_by_quantity["temperature"].valid_points == 2, "No temperature points should be generated by the widget")
	assert(view.series_by_quantity.has("concentration"), "Two quantities from one result may coexist")
	assert(view.active_result_ref.id == "synthetic-result" and int(view.active_result_ref.record_revision) == 1, "All graph tabs must identify one active result revision")

	# A second simulation must never be presented alongside an earlier result.
	var other_result := fixture.duplicate(true)
	other_result["result_ref"] = {"id": "new-synthetic-run", "record_revision": 1}
	assert(bool(view.submit_series(other_result, "0.1").get("ok", false)), "A newer valid run should replace previous results")
	assert(view.series_by_quantity.has("concentration"), "The newest run should be visible")
	assert(not view.series_by_quantity.has("temperature"), "New result ID must invalidate temperature from the old run")
	assert(str(view.active_result_ref.id) == "new-synthetic-run", "The active run identity must advance")

	# A new revision of the *same* run also invalidates the previous series.
	var newer_revision := temp_fixture.duplicate(true)
	newer_revision["result_ref"] = {"id": "new-synthetic-run", "record_revision": 2}
	assert(bool(view.submit_series(newer_revision, "0.1").get("ok", false)), "A newer result revision should be admitted")
	assert(not view.series_by_quantity.has("concentration"), "A changed result revision must invalidate stale concentration")
	assert(view.series_by_quantity.has("temperature"), "The current revision's temperature series should remain")
	assert(int(view.active_result_ref.record_revision) == 2, "The active result revision must be retained")

	var same_result_rate := {
		"series_id": "rate-same-result",
		"result_ref": {"id": "new-synthetic-run", "record_revision": 2},
		"quantity_key": "rate",
		"unit_id": "mol/(m3*s)",
		"samples": [{"time_s": 0.0, "value_status": "valid", "value": 2.0}]
	}
	assert(bool(view.submit_series(same_result_rate, "0.1").get("ok", false)), "Rate from the same result should be displayable")
	assert(view.series_by_quantity.has("rate") and view.series_by_quantity.has("temperature"), "Same-revision graph quantities may coexist")

	# Even a malformed or unknown-quantity payload must fail closed without
	# presenting unrelated cached data as if a new result had succeeded.
	var unknown_quantity := same_result_rate.duplicate(true)
	unknown_quantity["quantity_key"] = "pressure"
	assert(not bool(view.submit_series(unknown_quantity, "0.1").get("ok", true)), "Unknown plot kinds must be rejected")
	assert(view.series_by_quantity.is_empty() and view.active_result_ref.is_empty(), "Invalid unknown plot kind must clear every stale series")
	assert(view.error_by_quantity.has("temperature"), "An unknown plot kind must surface an error on the active tab")
	view.clear_series()
	assert(view.series_by_quantity.is_empty() and view.error_by_quantity.is_empty(), "Clearing results must remove all cached data and errors")
	view.queue_free()
	print("Graph series presentation tests passed")
	quit(0)
